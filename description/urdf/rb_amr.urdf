<?xml version="1.0"?>
<robot name="rb_amr">

  <!-- ===== base_link : 조립체 STL은 여기 visual로만 ===== -->
  <link name="base_link">
    <visual>
      <origin xyz="-0.25 -0.20 -0.10" rpy="1.5708 0 1.5708"/>
      <geometry>
        <!-- mm -> m -->
        <mesh filename="package://description/meshes/RB_AMR_ASSY.STL"
              scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>

    <!-- collision은 STL 대신 단순 박스 추천(물리 안정) -->
    <collision>
      <origin xyz="0 0 0.10" rpy="1.5708 0 1.5708"/>
      <geometry>
        <box size="0.40 0.30 0.20"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.10" rpy="0 0 0"/>
      <mass value="10.0"/>
      <inertia ixx="0.20" ixy="0" ixz="0" iyy="0.30" iyz="0" izz="0.40"/>
    </inertial>
  </link>

  <!-- ===== 왼쪽 바퀴 ===== -->
  <link name="left_wheel_link">
    <!-- 필요하면 visual은 투명 처리 가능(겉모습은 STL에 이미 있음) -->
    <visual>
      <origin xyz="0 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.033" length="0.02"/>
      </geometry>
      <material name="transparent">
        <color rgba="0 0 0 0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.033" length="0.02"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/>
    </inertial>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <!-- ⚠️ 아래 값은 로봇에 맞게 튜닝 필요 -->
    <origin xyz="0.0 0.11 0.03" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ===== 오른쪽 바퀴 ===== -->
  <link name="right_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.033" length="0.02"/>
      </geometry>
      <material name="transparent">
        <color rgba="0 0 0 0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.033" length="0.02"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/>
    </inertial>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <!-- ⚠️ 아래 값은 로봇에 맞게 튜닝 필요 -->
    <origin xyz="0.0 -0.11 0.03" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ===== Gazebo diff_drive : cmd_vel -> wheel joints ===== -->
  <gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <remapping>cmd_vel:=cmd_vel</remapping>
        <remapping>odom:=odom</remapping>
      </ros>

      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>

      <!-- ⚠️ 로봇 치수에 맞게 반드시 수정 -->
      <wheel_separation>0.22</wheel_separation>
      <wheel_diameter>0.066</wheel_diameter>

      <robot_base_frame>base_link</robot_base_frame>
      <odom_frame>odom</odom_frame>

      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <update_rate>50</update_rate>
    </plugin>
  </gazebo>

</robot>
